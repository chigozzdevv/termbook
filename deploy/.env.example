COMPOSE_PROJECT_NAME=termbook
TERMBOOK_RELEASE=local
TERMBOOK_BACKEND_IMAGE=termbook-backend
TERMBOOK_CLIENT_IMAGE=termbook-client
PUBLIC_API_BASE=http://localhost:3002
TERMBOOK_API_PORT=3002
TERMBOOK_CLIENT_PORT=4178

# Relative paths resolve from deploy/; absolute paths work too.
TERMBOOK_RUNTIME_ENV=./private/runtime.env
TERMBOOK_DATA_DIR=./private/data
TERMBOOK_MANIFEST=../deployments/testnet.json
TERMBOOK_OPERATOR_KEY_FILE=./private/testnet-operator.json
TERMBOOK_SOLANA_KEY_FILE=./private/solana-source-keeper.json
TERMBOOK_TUNNEL_TOKEN_FILE=./private/tunnel-token
