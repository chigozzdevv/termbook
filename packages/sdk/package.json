{
  "name": "@termbook/sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@solana/web3.js": "1.99.0",
    "@termbook/bindings": "workspace:^",
    "@termbook/schema": "workspace:^",
    "@wormhole-foundation/sdk-connect": "6.1.5",
    "@wormhole-foundation/sdk-solana-core": "6.1.5",
    "buffer": "6.0.3",
    "viem": "^2.56.3"
  },
  "description": "Embed Termbook credit in Monad apps and build validated app integrations.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chigozzdevv/termbook.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://termbook.xyz/docs",
  "bugs": {
    "url": "https://github.com/chigozzdevv/termbook/issues"
  },
  "keywords": [
    "termbook",
    "monad",
    "credit",
    "defi"
  ]
}
