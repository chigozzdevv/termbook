{
  "name": "termbook-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "verify:solana-program": "node --import tsx scripts/verify-solana-program.ts",
    "relay:ethereum-beacon-block": "node --import tsx scripts/relay-ethereum-beacon-block.ts",
    "test:kuru": "cd .. && tsx server/test/kuru/run-acceptance.ts",
    "test:kuru-fixture": "cd .. && tsx server/test/kuru/read-fixture.ts"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@envio-dev/hypersync-client": "0.7.2",
    "@noble/curves": "1.9.1",
    "@solana/web3.js": "1.99.0",
    "@termbook/bindings": "workspace:^",
    "@termbook/schema": "workspace:^",
    "@termbook/sdk": "workspace:^",
    "bullmq": "^6.3.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "ioredis": "^6.0.0",
    "mongoose": "^9.10.0",
    "viem": "^2.56.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
